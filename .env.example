# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#
# Supabase Dashboard (hosted project) — development setup:
# - Site URL: primary local origin (e.g. http://localhost:3000)
# - Redirect URLs allow list: add local callback paths:
#     http://localhost:3000/auth/callback
#     http://localhost:3000/auth/confirm
#     http://127.0.0.1:3000/auth/callback
#     http://127.0.0.1:3000/auth/confirm
# - Enable Google provider (Client ID + Secret from Google Cloud)
# - Confirm signup email template (PKCE):
#     <a href="{{ .RedirectTo }}?token_hash={{ .TokenHash }}&type=email">...</a>
#
# After deployment (when a production URL exists):
# - Change Site URL to the production origin
# - Add exact production /auth/callback and /auth/confirm URLs to Redirect URLs
# - Add production origin to Google Cloud Authorized JavaScript origins
